<%
  total_nodes = @nodes.size
  unlocked_nodes = current_user ? @node_progress_by_node_id.size : total_nodes
  completion_rate = total_nodes.positive? ? ((unlocked_nodes.to_f / total_nodes) * 100).round : 0
%>

<% content_for :sidebar do %>
  <div class="sidebar-stack">
    <div class="sidebar-actions">
      <%= link_to "Back to Chains", chains_path, class: "sidebar-button" %>
      <% if current_user && @chain.creator_user_id == current_user.id %>
        <%= button_to chain_path(@chain), method: :delete, class: "sidebar-icon-button", form: { data: { turbo_confirm: "Delete this chain?" } }, aria: { label: "Delete chain" } do %>
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M4 7H20" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
            <path d="M9.5 3.5H14.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
            <path d="M7 7L8 19C8.06 19.77 8.7 20.36 9.47 20.36H14.53C15.3 20.36 15.94 19.77 16 19L17 7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M10 10.25V16.25" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
            <path d="M14 10.25V16.25" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
          </svg>
        <% end %>
      <% end %>
    </div>

    <section class="sidebar-section">
      <h3>Chain Stats</h3>
      <div class="sidebar-stat-grid">
        <div class="achievement-stat-card achievement-stat-card--sidebar">
          <span class="achievement-stat-card__value"><%= total_nodes %></span>
          <span class="achievement-stat-card__label">Achievements In Chain</span>
        </div>
        <div class="achievement-stat-card achievement-stat-card--sidebar">
          <span class="achievement-stat-card__value"><%= completion_rate %>%</span>
          <span class="achievement-stat-card__label">Chain Completion</span>
        </div>
      </div>
    </section>

    <% if @chain.game&.name.present? || @chain.description.present? %>
      <section class="sidebar-section">
        <h3>Details</h3>
        <dl class="summary-list">
          <% if @chain.game&.name.present? %>
            <div>
              <dt>Game</dt>
              <dd><%= @chain.game.name %></dd>
            </div>
          <% end %>
        </dl>
      </section>
    <% end %>
  </div>
<% end %>

<section class="chain-show">
  <header class="chain-show__header">
    <div>
      <h1><%= @chain.title %></h1>
      <% if @chain.game&.name.present? %>
        <p class="chain-show__game"><%= @chain.game.name %></p>
      <% end %>
      <p class="chain-show__byline">
        <% if @chain.creator&.display_name.present? %>
          Created by <%= @chain.creator.display_name %>
        <% else %>
          Created by unknown
        <% end %>
        on <%= @chain.created_at.utc.strftime("%-d %b %Y @ %-I:%M%P UTC") %>
      </p>
      <% if @chain.description.present? %>
        <p class="chain-show__description"><%= @chain.description %></p>
      <% end %>
    </div>
  </header>

  <section class="achievements-section">
    <div class="achievements-section__header">
      <h2>Achievements</h2>
      <p class="achievements-section__meta"><%= total_nodes %> of <%= total_nodes %> shown</p>
    </div>

    <% if @nodes.any? %>
      <div class="achievement-list">
        <% @nodes.each_with_index do |node, index| %>
          <% progress = @node_progress_by_node_id[node.id] %>
          <% unlocked_for_current_user = current_user.blank? || progress.present? %>
          <% icon_url = if unlocked_for_current_user
                          node.achievement&.icon_unlocked || node.icon_unlocked
                        else
                          node.achievement&.icon_locked || node.icon_locked || node.achievement&.icon_unlocked || node.icon_unlocked
                        end %>
          <article class="achievement-row">
            <div class="achievement-row__icon-wrap">
              <% if icon_url.present? %>
                <%= image_tag icon_url, alt: "", class: "achievement-row__icon" %>
              <% else %>
                <div class="achievement-row__icon achievement-row__icon--placeholder" aria-hidden="true">
                  <span><%= index + 1 %></span>
                </div>
              <% end %>
            </div>

            <div class="achievement-row__body">
              <% if progress&.unlocked_at.present? %>
                <span class="achievement-row__unlock-time">
                  Unlocked <%= progress.unlocked_at.in_time_zone.strftime("%-d %b, %Y @ %-I:%M%P") %>
                </span>
              <% end %>

              <div class="achievement-row__title-line">
                <h3><%= node.title %></h3>
                <% if node.node_type.present? %>
                  <span class="achievement-row__type"><%= node.node_type.humanize %></span>
                <% end %>
              </div>

              <p class="achievement-row__description"><%= node.description %></p>

              <div class="achievement-row__meta">
                <span>Step <%= index + 1 %> of <%= total_nodes %></span>
              </div>
            </div>
          </article>
        <% end %>
      </div>
    <% else %>
      <div class="achievement-empty-state">
        <h3>No visible achievements yet</h3>
        <p>This chain does not currently expose any achievement entries to render.</p>
      </div>
    <% end %>
  </section>
</section>
