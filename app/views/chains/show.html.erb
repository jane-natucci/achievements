<%
  total_nodes = @nodes.size
  unlocked_nodes = current_user ? @node_progress_by_node_id.size : total_nodes
  completion_rate = total_nodes.positive? ? ((unlocked_nodes.to_f / total_nodes) * 100).round : 0
%>

<% content_for :sidebar do %>
  <div class="sidebar-stack">
    <div class="sidebar-actions">
      <%= link_to chains_path, class: "sidebar-icon-button sidebar-icon-button--nav", title: "Back to all chains", aria: { label: "Back to all chains" } do %>
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M14.75 5.5L8.25 12L14.75 18.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      <% end %>
      <% if current_user && @chain.creator_user_id == current_user.id %>
        <%= link_to edit_chain_path(@chain), class: "sidebar-icon-button sidebar-icon-button--edit", title: "Edit this chain", aria: { label: "Edit this chain" } do %>
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M4 20H8.5L18 10.5C18.83 9.67 18.83 8.33 18 7.5L16.5 6C15.67 5.17 14.33 5.17 13.5 6L4 15.5V20Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
            <path d="M12.5 7L17 11.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
          </svg>
        <% end %>
      <% end %>
      <% if current_user %>
        <%= button_to @favorited ? favorite_chain_path(@chain) : favorite_chain_path(@chain),
              method: @favorited ? :delete : :post,
              class: ["sidebar-icon-button", "sidebar-icon-button--star", (@favorited ? "sidebar-icon-button--star-active" : nil)].compact.join(" "),
              title: @favorited ? "Remove from favorites" : "Add to favorites",
              aria: { label: @favorited ? "Remove from favorites" : "Add to favorites" } do %>
          <svg viewBox="0 0 24 24" fill="<%= @favorited ? 'currentColor' : 'none' %>" aria-hidden="true">
            <path d="M12 3.7L14.55 8.87L20.25 9.7L16.12 13.72L17.1 19.4L12 16.72L6.9 19.4L7.88 13.72L3.75 9.7L9.45 8.87L12 3.7Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
          </svg>
        <% end %>
      <% end %>
      <% if current_user && @chain.creator_user_id == current_user.id %>
        <% delete_icon = capture do %>
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M4 7H20" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
            <path d="M9.5 3.5H14.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
            <path d="M7 7L8 19C8.06 19.77 8.7 20.36 9.47 20.36H14.53C15.3 20.36 15.94 19.77 16 19L17 7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M10 10.25V16.25" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
            <path d="M14 10.25V16.25" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
          </svg>
        <% end %>

        <% if steam_verified? %>
          <%= button_to chain_path(@chain), method: :delete, class: "sidebar-icon-button sidebar-icon-button--danger", form: { data: { turbo_confirm: "Delete this chain?" } }, title: "Delete this chain", aria: { label: "Delete this chain" } do %>
            <%= delete_icon %>
          <% end %>
        <% else %>
          <%= link_to login_steam_path, class: "sidebar-icon-button sidebar-icon-button--danger sidebar-icon-button--muted", title: "Sign in with Steam to remove chains", aria: { label: "Sign in with Steam to remove chains" } do %>
            <%= delete_icon %>
          <% end %>
        <% end %>
      <% end %>
    </div>

    <section class="sidebar-section">
      <h3>Chain Stats</h3>
      <div class="sidebar-stat-grid">
        <div class="achievement-stat-card achievement-stat-card--sidebar">
          <span class="achievement-stat-card__value"><%= total_nodes %></span>
          <span class="achievement-stat-card__label">Achievements In Chain</span>
        </div>
        <div class="achievement-stat-card achievement-stat-card--sidebar">
          <span class="achievement-stat-card__value"><%= completion_rate %>%</span>
          <span class="achievement-stat-card__label">Chain Completion</span>
        </div>
      </div>
    </section>

    <% if @chain.game&.name.present? || @chain.description.present? %>
      <section class="sidebar-section">
        <h3>Details</h3>
        <dl class="summary-list">
          <% if @chain.game&.name.present? %>
            <div>
              <dt>Game</dt>
              <dd><%= @chain.game.name %></dd>
            </div>
          <% end %>
        </dl>
      </section>
    <% end %>
  </div>
<% end %>

<section class="chain-show">
  <header class="chain-show__header">
    <div>
      <h1><%= @chain.title %></h1>
      <% if @chain.game&.name.present? %>
        <p class="chain-show__game">
          <%= link_to @chain.game.name,
                chains_path(game: @chain.game.id),
                class: "chain-show__game-link",
                title: "See all chains for this game",
                aria: { label: "See all chains for this game" } %>
          <% if @chain.game.steam_app_id.present? %>
            <%= link_to "Open on Steam ↗",
                  "https://store.steampowered.com/app/#{@chain.game.steam_app_id}/",
                  class: "chain-show__steam-link",
                  title: "Open on Steam",
                  target: "_blank",
                  rel: "noopener noreferrer" %>
            <% if current_user&.steam_id.present? %>
              <%= link_to "See my achievements on Steam ↗",
                    "https://steamcommunity.com/profiles/#{current_user.steam_id}/stats/#{@chain.game.steam_app_id}/?tab=achievements",
                    class: "chain-show__steam-link",
                    title: "See my achievements on Steam",
                    target: "_blank",
                    rel: "noopener noreferrer" %>
            <% end %>
          <% end %>
        </p>
      <% end %>
      <p class="chain-show__byline">
        <% if @chain.creator&.display_name.present? %>
          Created by <%= link_to @chain.creator.display_name, user_path(@chain.creator) %>
        <% else %>
          Created by unknown
        <% end %>
        on <%= @chain.created_at.utc.strftime("%-d %b %Y @ %-I:%M%P UTC") %>
      </p>
      <% if @chain.description.present? %>
        <div class="chain-show__description"><%= simple_format(@chain.description) %></div>
      <% end %>
    </div>
  </header>

  <section class="achievements-section">
    <div class="achievements-section__header">
      <h2>Achievements</h2>
      <p class="achievements-section__meta"><%= total_nodes %> of <%= total_nodes %> shown</p>
    </div>

    <% if @nodes.any? %>
      <div class="achievement-list">
        <% @nodes.each_with_index do |node, index| %>
          <% progress = @node_progress_by_node_id[node.id] %>
          <% unlocked_for_current_user = current_user.blank? || progress.present? %>
          <% icon_url = if unlocked_for_current_user
                          node.achievement&.icon_unlocked || node.icon_unlocked
                        else
                          node.achievement&.icon_locked || node.icon_locked || node.achievement&.icon_unlocked || node.icon_unlocked
                        end %>
          <article class="achievement-step">
            <% if node.note.present? %>
              <div class="achievement-note">
                <div class="achievement-note__body"><%= simple_format(node.note) %></div>
              </div>
            <% end %>

            <div class="achievement-row">
              <div class="achievement-row__icon-wrap">
                <%= link_to achievement_path(node.achievement), class: "achievement-row__link", aria: { label: node.title } do %>
                  <% if icon_url.present? %>
                    <%= image_tag icon_url, alt: "", class: "achievement-row__icon" %>
                  <% else %>
                    <div class="achievement-row__icon achievement-row__icon--placeholder" aria-hidden="true">
                      <span><%= index + 1 %></span>
                    </div>
                  <% end %>
                <% end %>
              </div>

              <div class="achievement-row__body">
                <% if progress&.unlocked_at.present? %>
                  <span class="achievement-row__unlock-time">
                    Unlocked <%= progress.unlocked_at.in_time_zone.strftime("%-d %b, %Y @ %-I:%M%P") %>
                  </span>
                <% end %>

                <div class="achievement-row__title-line">
                  <h3><%= link_to node.title, achievement_path(node.achievement), class: "achievement-row__title-link" %></h3>
                  <% if node.node_type.present? %>
                    <span class="achievement-row__type"><%= node.node_type.humanize %></span>
                  <% end %>
                </div>

                <div class="achievement-row__description"><%= simple_format(node.description) %></div>

                <div class="achievement-row__meta">
                  <span>Step <%= index + 1 %> of <%= total_nodes %></span>
                </div>
              </div>
            </div>
          </article>
        <% end %>
      </div>
    <% else %>
      <div class="achievement-empty-state">
        <h3>No visible achievements yet</h3>
        <p>This chain does not currently expose any achievement entries to render.</p>
      </div>
    <% end %>
  </section>

  <%= render "comments/comments", commentable: @chain %>
</section>
