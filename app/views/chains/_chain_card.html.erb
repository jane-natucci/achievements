<%
  ordered_nodes = chain.nodes_in_order
  display_nodes = ordered_nodes.presence || chain.chain_nodes.to_a
  first_node = display_nodes.first
  last_node = display_nodes.last
  last_icon_url = last_node&.achievement&.icon_unlocked || last_node&.icon_unlocked
  icon_markup = capture do
%>
    <div class="chain-card__icon-wrap <%= "chain-card__icon-wrap--glow" if last_icon_url.present? %>">
      <% if last_icon_url.present? %>
        <%= image_tag last_icon_url, alt: "", class: "chain-card__icon" %>
      <% else %>
        <div class="chain-card__icon chain-card__icon--placeholder" aria-hidden="true">
          <span><%= display_nodes.size %></span>
        </div>
      <% end %>
    </div>
<% end %>

<article class="chain-card">
  <div class="chain-card__top">
    <div class="chain-card__lead">
      <%= link_to icon_markup, chain_path(chain), class: "chain-card__icon-link", aria: { label: "Open #{chain.title}" } %>

      <div class="chain-card__heading">
        <h2><%= link_to chain.title, chain_path(chain) %></h2>
        <p class="chain-card__game"><%= chain.game&.name || "Unknown Game" %></p>
      </div>
    </div>

    <div class="chain-card__stats">
      <div class="chain-card__stat">
        <span class="chain-card__stat-value"><%= display_nodes.size %></span>
        <span class="chain-card__stat-label">Achievements</span>
      </div>
    </div>
  </div>

  <% if chain.description.present? %>
    <p class="chain-card__description"><%= chain.description %></p>
  <% end %>

  <div class="chain-card__details">
    <div class="chain-card__detail">
      <span class="chain-card__detail-label">Starts With</span>
      <span class="chain-card__detail-value"><%= first_node&.title || "No starting achievement" %></span>
    </div>
    <div class="chain-card__detail">
      <span class="chain-card__detail-label">Ends With</span>
      <span class="chain-card__detail-value"><%= last_node&.title || "No final achievement" %></span>
    </div>
  </div>

  <% if chain.visibility.present? || chain.featured_score.present? %>
    <div class="chain-card__footer">
      <% if chain.visibility.present? %>
        <span class="chain-card__pill"><%= chain.visibility.humanize %></span>
      <% end %>
      <% if chain.featured_score.present? %>
        <span class="chain-card__pill">Featured <%= chain.featured_score %></span>
      <% end %>
    </div>
  <% end %>
</article>
