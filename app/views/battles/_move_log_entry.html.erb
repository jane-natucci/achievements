<li class="battle-log__entry">
  <span class="battle-log__side battle-log__side--<%= move.acting_side %>">
    <%= move.acting_side == "player" ? battle_player_link(battle) : battle_shadow_name(battle) %>
  </span>
  <span class="battle-log__actor"
        data-battle-card-id="<%= move.acting_battle_card_id %>"
        data-action="mouseenter->battle#highlightCard mouseleave->battle#unhighlightCard">
    <% if move.acting_battle_card.achievement.icon_unlocked.present? %>
      <%= image_tag move.acting_battle_card.achievement.icon_unlocked, alt: "", class: "battle-log__icon", onerror: achievement_icon_onerror %>
    <% end %>
    <%= move.acting_battle_card.achievement.title %>
  </span>
  attacked
  <% if move.target_type == "player" %>
    <% target_side = battle.opposite_side(move.acting_side) %>
    <span class="battle-log__target">
      <span class="battle-log__side battle-log__side--<%= target_side %>">
        <%= target_side == "player" ? battle_player_link(battle) : battle_shadow_name(battle) %>
      </span>
    </span>
  <% else %>
    <span class="battle-log__target"
          data-battle-card-id="<%= move.target_battle_card_id %>"
          data-action="mouseenter->battle#highlightTargetCard mouseleave->battle#unhighlightCard">
      <% if move.target_battle_card.achievement.icon_unlocked.present? %>
        <%= image_tag move.target_battle_card.achievement.icon_unlocked, alt: "", class: "battle-log__icon", onerror: achievement_icon_onerror %>
      <% end %>
      <%= move.target_battle_card.achievement.title %>
    </span>
  <% end %>
  for <strong class="battle-log__damage"><%= move.damage_dealt %></strong> dmg
  <% if move.target_type == "card" %>
    <% if move.target_hp_after.zero? %>
      <span class="battle-log__death">💀 died!</span>
    <% end %>
    -- took <strong class="battle-log__damage"><%= move.target_battle_card.dmg %></strong> dmg back
    <% if move.acting_hp_after&.zero? %>
      <span class="battle-log__death">💀 died!</span>
    <% end %>
  <% end %>
  <time class="battle-log__time"><%= move.created_at.strftime("%-I:%M:%S%P") %></time>
</li>
