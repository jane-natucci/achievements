<li class="battle-log__entry battle-log__entry--result battle-log__entry--<%= battle.status %>">
  <% if battle.status == "won" %>
    <strong><%= battle_player_link(battle) %></strong> defeated <strong><%= battle_shadow_name(battle) %></strong> -- You won!
  <% else %>
    <strong><%= battle_shadow_name(battle) %></strong> defeated <strong><%= battle_player_link(battle) %></strong> -- You lost.
  <% end %>
</li>
