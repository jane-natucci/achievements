<li class="battle-log__entry battle-log__entry--<%= battle.status %>">
  <% if battle.status == "won" %>
    <span class="battle-log__side battle-log__side--player"><%= battle_player_link(battle) %></span>
    defeated
    <span class="battle-log__side battle-log__side--opponent"><%= battle_shadow_name(battle) %></span>
    -- Victory.
  <% else %>
    <span class="battle-log__side battle-log__side--opponent"><%= battle_shadow_name(battle) %></span>
    defeated
    <span class="battle-log__side battle-log__side--player"><%= battle_player_link(battle) %></span>
    -- Defeat.
  <% end %>
  <time class="battle-log__time"><%= battle.updated_at.strftime("%-I:%M:%S%P") %></time>
</li>
