<% content_for :sidebar do %>
  <div class="sidebar-stack">
    <%= link_to "Back to Battles", battles_path, class: "sidebar-button" %>
  </div>
<% end %>

<section class="battle-page"
         data-controller="battle"
         data-battle-turn-url-value="<%= turn_battle_path(@battle) %>"
         data-battle-active-value="<%= @battle.active? %>">
  <header class="achievements-section__header">
    <h1>Battle</h1>
    <p class="achievements-section__meta" data-battle-target="status">
      <% if @battle.active? %>
        <%= @battle.current_turn_side == "player" ? "Your turn" : "Opponent's turn" %>
      <% else %>
        <%= @battle.status == "won" ? "You won!" : "You lost." %>
      <% end %>
    </p>
  </header>

  <div data-battle-target="board">
    <%= render "board", battle: @battle %>
  </div>

  <% if @battle.active? %>
    <div class="battle-controls">
      <div class="battle-stance-picker" data-battle-target="stancePicker">
        <span class="battle-stance-picker__label">Stance:</span>
        <button type="button" class="battle-stance-button" data-stance="attack" data-action="click->battle#chooseStance">Attack</button>
        <button type="button" class="battle-stance-button battle-stance-button--active" data-stance="neutral" data-action="click->battle#chooseStance">Neutral</button>
        <button type="button" class="battle-stance-button" data-stance="defense" data-action="click->battle#chooseStance">Defense</button>
      </div>
      <button type="button" class="sidebar-button" data-battle-target="readyButton" data-action="click->battle#submitTurn" disabled>
        Ready
      </button>
      <p class="battle-controls__hint" data-battle-target="hint">Select a card to attack with.</p>
    </div>
  <% end %>

  <section class="battle-log-section">
    <h2>Log</h2>
    <ul class="battle-log" data-battle-target="log">
      <% @battle.battle_moves.includes(:acting_battle_card, :target_battle_card).order(:turn_number).each do |move| %>
        <%= render "move_log_entry", move: move %>
      <% end %>
    </ul>
  </section>
</section>
