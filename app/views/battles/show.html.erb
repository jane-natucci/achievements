<% content_for :sidebar do %>
  <div class="sidebar-stack">
    <%= link_to "Back to Battles", battles_path, class: "sidebar-button" %>
  </div>
<% end %>

<section class="battle-page"
         data-controller="battle"
         data-battle-place-url-value="<%= place_battle_path(@battle) %>"
         data-battle-attack-url-value="<%= attack_battle_path(@battle) %>"
         data-battle-end-turn-url-value="<%= end_turn_battle_path(@battle) %>"
         data-battle-active-value="<%= @battle.active? %>"
         data-battle-turn-started-at-value="<%= @battle.turn_started_at&.to_i %>"
         data-battle-turn-seconds-value="<%= Battle::TURN_SECONDS %>">
  <header class="achievements-section__header">
    <h1><%= battle_player_name(@battle) %> vs <%= battle_shadow_name(@battle) %></h1>
    <p class="achievements-section__meta" data-battle-target="status">
      <% if @battle.active? %>
        Your turn
      <% else %>
        <%= @battle.status == "won" ? "You won!" : "You lost." %>
      <% end %>
    </p>
  </header>

  <div data-battle-target="board">
    <%= render "board", battle: @battle %>
  </div>

  <% if @battle.active? %>
    <div class="battle-controls">
      <button type="button" class="sidebar-button" data-battle-target="readyButton" data-action="click->battle#endTurn">
        Ready
      </button>
      <span class="battle-controls__timer" data-battle-target="timer" aria-live="polite"></span>
      <p class="battle-controls__hint" data-battle-target="hint">Click a hand card to place it, or select a board card then a target to attack.</p>
    </div>
  <% end %>

  <section class="battle-log-section">
    <h2>Log</h2>
    <ul class="battle-log" data-battle-target="log">
      <% unless @battle.active? %>
        <%= render "result_log_entry", battle: @battle %>
      <% end %>
      <% @battle.battle_moves.includes(:acting_battle_card, :target_battle_card).order(move_number: :desc).each do |move| %>
        <%= render "move_log_entry", battle: @battle, move: move %>
      <% end %>
      <%= render "start_log_entry", battle: @battle %>
    </ul>
  </section>
</section>
