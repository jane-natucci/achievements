<li class="battle-log__entry battle-log__entry--start">
  Battle between
  <span class="battle-log__side battle-log__side--player"><%= battle_player_link(battle) %></span>
  (<%= battle_player_deck_link(battle) %>)
  and
  <span class="battle-log__side battle-log__side--opponent"><%= battle_shadow_name(battle) %></span>
  (<%= battle_opponent_deck_link(battle) %>)
  started.
  <time class="battle-log__time"><%= battle.created_at.strftime("%-I:%M:%S%P") %></time>
</li>
