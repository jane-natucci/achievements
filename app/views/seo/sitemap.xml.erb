<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
<% @entries.each do |url, modified, priority| %>
  <url><loc><%= url %></loc><% if modified %><lastmod><%= modified.utc.strftime("%Y-%m-%d") %></lastmod><% end %><priority><%= priority %></priority></url>
<% end %>
</urlset>
