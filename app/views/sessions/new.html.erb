<% content_for :sidebar do %>
  <div class="sidebar-stack">
    <%= link_to "Back Home", "/achievements/", class: "sidebar-button" %>

    <% if current_user %>
      <section class="sidebar-section">
        <h3>Current User</h3>
        <dl class="summary-list">
          <div>
            <dt>Name</dt>
            <dd><%= current_user.display_name %></dd>
          </div>
          <div>
            <dt>Steam ID</dt>
            <dd><%= current_user.steam_id %></dd>
          </div>
          <div>
            <dt>Verified</dt>
            <dd><%= steam_verified? ? "Yes, via Steam sign-in" : "No, paste-URL login" %></dd>
          </div>
        </dl>
        <%= button_to "Log Out", "/achievements/logout/", method: :delete, class: "sidebar-button sidebar-button--secondary" %>
      </section>
    <% end %>
  </div>
<% end %>

<section class="chain-index">
  <header class="chain-index__header">
    <p class="eyebrow">Steam Progress</p>
    <h1>Log In</h1>
  </header>

  <div class="chain-card login-card">
    <div>
      <p>Log in to create your own achievement chains and see your progress.</p>
      <p class="chain-builder__hint">Your games must be public on Steam so achievements can sync.</p>
    </div>

    <%= link_to "Sign in with Steam", login_steam_path, class: "sidebar-button" %>
    <p class="chain-builder__hint">Proves the account is actually yours -- required to remove a chain you created.</p>

    <div class="login-divider">or</div>

    <%= form_with url: "/achievements/login/", method: :post, class: "login-form" do |form| %>
      <div class="chain-builder-panel__section">
        <%= form.label :profile_url, "Steam Profile URL Or SteamID64", class: "chain-builder__label" %>
        <%= form.text_field :profile_url,
              value: params[:profile_url],
              class: "chain-builder__input",
              placeholder: "https://steamcommunity.com/profiles/76561199079570785/" %>
        <p class="chain-builder__hint">
          Accepted: full <code>/profiles/...</code> URL, full <code>/id/...</code> vanity URL, or a raw 17-digit SteamID64.
        </p>
      </div>

      <div class="chain-builder-panel__section">
        <%= form.submit "Log In", class: "sidebar-button chain-builder__submit" %>
      </div>
    <% end %>
  </div>
</section>
