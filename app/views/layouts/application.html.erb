<!DOCTYPE html>
<html>
  <head>
    <title><%= page_title("Achievements") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Achievements">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <%= Sentry.get_trace_propagation_meta.html_safe %>
    <%= render "shared/analytics" %>
  </head>

  <body
    class="steam-shell<%= " steam-shell--dashboard" if controller_name == "achievements" && action_name == "index" %>"
    data-controller="pull-refresh<%= " presence" if current_user %>"
    data-presence-url-value="<%= heartbeat_path %>"
  >
    <div class="pull-refresh-indicator" data-pull-refresh-target="indicator" aria-hidden="true">
      <span class="pull-refresh-spinner"></span>
    </div>

    <header class="topbar">
      <div class="topbar__inner" data-controller="topbar-menu">
        <div class="topbar__row">
          <div class="topbar__brand">
            <%= link_to(header_avatar_link_path, class: "topbar__avatar-link", aria: { label: header_avatar_link_label }) do %>
              <div class="topbar__avatar-slot">
                <% if current_user %>
                  <span class="avatar-status-dot<%= " avatar-status-dot--online" if current_user.online? %>"></span>
                <% end %>
                <% if current_user&.avatar_url.present? %>
                  <%= image_tag current_user.avatar_url, alt: "", class: "topbar__avatar-image" %>
                <% elsif random_header_achievement_icon_url.present? %>
                  <%= image_tag random_header_achievement_icon_url, alt: "", class: "topbar__avatar-image" %>
                <% else %>
                  <span class="topbar__avatar-initial"><%= current_user&.display_name&.first&.upcase || "A" %></span>
                <% end %>
              </div>
            <% end %>

            <div class="brand-lockup">
              <h1><a href="/achievements/">Achievement Chainz</a></h1>
            </div>
          </div>

          <button
            type="button"
            class="topbar__menu-toggle"
            data-topbar-menu-target="toggle"
            data-action="click->topbar-menu#toggle"
            aria-expanded="false"
            aria-controls="topbar-nav"
            aria-label="Toggle navigation menu"
          >
            <span class="topbar__menu-toggle-bar"></span>
            <span class="topbar__menu-toggle-bar"></span>
            <span class="topbar__menu-toggle-bar"></span>
          </button>
        </div>

        <nav class="topbar__nav" id="topbar-nav" aria-label="Primary" data-topbar-menu-target="nav">
          <%= link_to "Battle", new_battle_path, class: "topbar__nav-link--battle" %>
          <% if build_commit_sha.present? %>
            <div class="build-popup-wrapper" data-controller="build-popup" data-action="mouseenter->build-popup#show mouseleave->build-popup#hide">
              <%= link_to "Build #{build_commit_short_sha}", build_commit_url, class: "topbar__build-link", target: "_blank", rel: "noopener noreferrer", title: "View deployed source commit on GitHub" %>
              <div class="build-popup" data-build-popup-target="popup">
                <div class="build-popup__inner">
                  <%= link_to "Debug →", debug_path, class: "build-popup__link" %>
                </div>
              </div>
            </div>
          <% end %>
          <% if current_user %>
            <%= button_to "Log Out", "/achievements/logout/", method: :delete, class: "topbar__nav-button" %>
          <% else %>
            <a href="/achievements/login/">Log In</a>
          <% end %>
          <a href="/achievements/">Home</a>
          <a href="/achievements/chains/">Chains</a>
          <%= link_to "Leaderboard", leaderboard_path %>
          <a href="/achievements/help/">Help</a>
        </nav>
      </div>
    </header>

    <main class="profile-shell">
      <% if flash[:notice].present? || flash[:alert].present? %>
        <div class="flash-stack">
          <% if flash[:notice].present? %>
            <div class="flash-banner flash-banner--notice"><%= flash[:notice] %></div>
          <% end %>
          <% if flash[:alert].present? %>
            <div class="flash-banner flash-banner--alert"><%= flash[:alert] %></div>
          <% end %>
        </div>
      <% end %>

      <div class="profile-grid">
        <aside class="panel summary-panel">
          <% if content_for?(:sidebar) %>
            <%= yield :sidebar %>
          <% else %>
            <h3>Summary</h3>
            <dl class="summary-list">
              <div>
                <dt>Focus</dt>
                <dd>Achievement tracking</dd>
              </div>
              <div>
                <dt>Status</dt>
                <dd>In progress</dd>
              </div>
              <div>
                <dt>Style</dt>
                <dd>Clean Steam-inspired shell</dd>
              </div>
            </dl>
          <% end %>
        </aside>

        <section class="panel content-panel" role="main">
          <div class="view-content">
            <%= yield %>
          </div>
        </section>
      </div>
    </main>

    <%= render "shared/cookie_consent_banner" %>
  </body>
</html>
