<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Achievements" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Achievements">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <%= Sentry.get_trace_propagation_meta.html_safe %>
  </head>

  <body class="steam-shell">
    <header class="topbar">
      <div class="topbar__inner">
        <div class="topbar__brand">
          <%= link_to(current_user ? "/achievements/" : "/achievements/login/", class: "topbar__avatar-link", aria: { label: current_user ? "Home" : "Log In" }) do %>
            <div class="topbar__avatar-slot">
              <span class="topbar__avatar-status"></span>
              <% if current_user&.avatar_url.present? %>
                <%= image_tag current_user.avatar_url, alt: "", class: "topbar__avatar-image" %>
              <% elsif random_header_achievement_icon_url.present? %>
                <%= image_tag random_header_achievement_icon_url, alt: "", class: "topbar__avatar-image" %>
              <% else %>
                <span class="topbar__avatar-initial"><%= current_user&.display_name&.first&.upcase || "A" %></span>
              <% end %>
            </div>
          <% end %>

          <div class="brand-lockup">
            <h1><a href="/achievements/">Achievement Chains</a></h1>
          </div>
        </div>

        <nav class="topbar__nav" aria-label="Primary">
          <% if current_user %>
            <%= button_to "Log Out", "/achievements/logout/", method: :delete, class: "topbar__nav-button" %>
          <% else %>
            <a href="/achievements/login/">Log In</a>
          <% end %>
          <a href="/achievements/">Home</a>
          <a href="/achievements/chains/">Chains</a>
          <a href="/achievements/help/">Help</a>
        </nav>
      </div>
    </header>

    <main class="profile-shell">
      <% if flash[:notice].present? || flash[:alert].present? %>
        <div class="flash-stack">
          <% if flash[:notice].present? %>
            <div class="flash-banner flash-banner--notice"><%= flash[:notice] %></div>
          <% end %>
          <% if flash[:alert].present? %>
            <div class="flash-banner flash-banner--alert"><%= flash[:alert] %></div>
          <% end %>
        </div>
      <% end %>

      <div class="profile-grid">
        <aside class="panel summary-panel">
          <% if content_for?(:sidebar) %>
            <%= yield :sidebar %>
          <% else %>
            <h3>Summary</h3>
            <dl class="summary-list">
              <div>
                <dt>Focus</dt>
                <dd>Achievement tracking</dd>
              </div>
              <div>
                <dt>Status</dt>
                <dd>In progress</dd>
              </div>
              <div>
                <dt>Style</dt>
                <dd>Clean Steam-inspired shell</dd>
              </div>
            </dl>
          <% end %>
        </aside>

        <section class="panel content-panel" role="main">
          <div class="view-content">
            <%= yield %>
          </div>
        </section>
      </div>
    </main>
  </body>
</html>
