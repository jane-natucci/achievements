<% content_for :sidebar do %>
  <div class="sidebar-stack">
    <%= link_to "Build Your First Chain", wizard_path, class: "sidebar-button" %>

    <section class="sidebar-section">
      <h3>Overview</h3>
      <div class="sidebar-stat-grid">
        <div class="achievement-stat-card achievement-stat-card--sidebar">
          <span class="achievement-stat-card__value"><%= @total_chains %></span>
          <span class="achievement-stat-card__label">Published Chains</span>
        </div>
        <div class="achievement-stat-card achievement-stat-card--sidebar">
          <span class="achievement-stat-card__value"><%= @total_achievements %></span>
          <span class="achievement-stat-card__label">Achievements Tracked</span>
        </div>
      </div>
    </section>

    <section class="sidebar-section">
      <h3>By Game</h3>
      <%= render "chains/game_filters",
            games: @filter_games,
            active_game_id: nil,
            all_path: chains_path,
            label_all: "All Chains",
            filter_path: ->(game) { chains_path(game: game.id) } %>
    </section>

    <% if current_user %>
      <section class="sidebar-section">
        <h3>Library</h3>
        <div class="game-filter-list">
          <%= link_to "Saved Chains", chains_path(favorites: 1), class: "game-filter-chip" %>
        </div>
      </section>
    <% end %>
  </div>
<% end %>

<section class="chain-index">
  <header class="chain-index__header">
    <p class="eyebrow">News</p>
    <h1>What's Happening</h1>
    <p class="chain-index__description">
      See what the community's been up to &mdash; achievements unlocked, chains created and completed, across every player.
    </p>
  </header>

  <% if @recent_events.any? %>
    <ul class="news-feed">
      <% @recent_events.each do |event| %>
        <li class="news-feed__row">
          <%= link_to user_path(event.user), class: "leaderboard-row__avatar-wrap" do %>
            <% if event.user.avatar_url.present? %>
              <%= image_tag event.user.avatar_url, alt: "", class: "leaderboard-row__avatar" %>
            <% else %>
              <span class="leaderboard-row__avatar leaderboard-row__avatar--placeholder"><%= event.user.display_name&.first&.upcase || "?" %></span>
            <% end %>
          <% end %>

          <%= xp_event_subject_icon(event) %>

          <span class="news-feed__description">
            <%= link_to event.user.display_name.presence || "Unknown Player", user_path(event.user), class: "news-feed__actor-name" %>
            <%= xp_event_description(event) %>
          </span>

          <span class="xp-feed__time"><%= time_ago_in_words(event.created_at) %> ago</span>
        </li>
      <% end %>
    </ul>
  <% else %>
    <div class="achievement-empty-state">
      <h3>Nothing yet</h3>
      <p>Once players start earning XP, their activity will show up here.</p>
      <p><%= link_to "Build Your First Chain", wizard_path, class: "sidebar-button" %></p>
    </div>
  <% end %>
</section>
