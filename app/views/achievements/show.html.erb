<%
  chains = @chain_nodes.map(&:chain).uniq
%>

<% content_for :sidebar do %>
  <div class="sidebar-stack">
    <div class="sidebar-actions">
      <%= link_to "Back to Chains", chains_path, class: "sidebar-button" %>

      <% if current_user %>
        <%= button_to @favorited ? favorite_achievement_path(@achievement) : favorite_achievement_path(@achievement),
              method: @favorited ? :delete : :post,
              class: ["sidebar-icon-button", "sidebar-icon-button--star", (@favorited ? "sidebar-icon-button--star-active" : nil)].compact.join(" "),
              title: @favorited ? "Remove from favorites" : "Add to favorites",
              aria: { label: @favorited ? "Remove from favorites" : "Add to favorites" } do %>
          <svg viewBox="0 0 24 24" fill="<%= @favorited ? 'currentColor' : 'none' %>" aria-hidden="true">
            <path d="M12 3.7L14.55 8.87L20.25 9.7L16.12 13.72L17.1 19.4L12 16.72L6.9 19.4L7.88 13.72L3.75 9.7L9.45 8.87L12 3.7Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
          </svg>
        <% end %>
      <% end %>

      <% if current_user && @already_unlocked && (@pinned || @can_pin_more) %>
        <%= button_to @pinned ? pin_achievement_path(@achievement) : pin_achievement_path(@achievement),
              method: @pinned ? :delete : :post,
              class: ["sidebar-icon-button", "sidebar-icon-button--pin", (@pinned ? "sidebar-icon-button--pin-active" : nil)].compact.join(" "),
              title: @pinned ? "Unpin from wall" : "Pin to wall",
              aria: { label: @pinned ? "Unpin from wall" : "Pin to wall" } do %>
          <svg viewBox="0 0 24 24" fill="<%= @pinned ? 'currentColor' : 'none' %>" aria-hidden="true">
            <path d="M9 3H15V9L18 12H13V20L12 22L11 20V12H6L9 9V3Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
          </svg>
        <% end %>
      <% end %>
    </div>

    <section class="sidebar-section">
      <h3>Achievement</h3>
      <div class="sidebar-stat-grid">
        <div class="achievement-stat-card achievement-stat-card--sidebar">
          <span class="achievement-stat-card__value"><%= chains.size %></span>
          <span class="achievement-stat-card__label">Chains Using This</span>
        </div>
        <div class="achievement-stat-card achievement-stat-card--sidebar">
          <span class="achievement-stat-card__value"><%= @favorite_count %></span>
          <span class="achievement-stat-card__label">Favorites</span>
        </div>
      </div>
    </section>
  </div>
<% end %>

<section class="achievement-detail">
  <header class="achievement-detail__header">
    <div class="achievement-detail__icon-wrap">
      <% if @achievement.icon_unlocked.present? %>
        <%= image_tag @achievement.icon_unlocked, alt: "", class: "achievement-detail__icon", onerror: achievement_icon_onerror %>
      <% else %>
        <div class="achievement-detail__icon achievement-detail__icon--placeholder" aria-hidden="true"></div>
      <% end %>
    </div>

    <div class="achievement-detail__copy">
      <p class="eyebrow">Achievement</p>
      <h1><%= @achievement.title %></h1>
      <% if @achievement.game&.name.present? %>
        <p class="achievement-detail__game"><%= @achievement.game.name %></p>
      <% end %>
      <% if @achievement.description.present? %>
        <div class="achievement-detail__description"><%= simple_format(@achievement.description) %></div>
      <% end %>
    </div>
  </header>

  <% if @chain_nodes.any? %>
    <section class="achievements-section">
      <div class="achievements-section__header">
        <h2>Used In Chains</h2>
        <p class="achievements-section__meta"><%= pluralize(chains.size, "chain") %></p>
      </div>

      <div class="achievement-detail__chains">
        <% @chain_nodes.each do |node| %>
          <article class="achievement-link-card">
            <div class="achievement-link-card__body">
              <h3><%= link_to node.chain.title, chain_path(node.chain) %></h3>
              <p class="achievement-link-card__game"><%= node.chain.game&.name || "Unknown Game" %></p>
              <% if node.note.present? %>
                <div class="achievement-link-card__note"><%= simple_format(node.note) %></div>
              <% end %>
            </div>
          </article>
        <% end %>
      </div>
    </section>
  <% end %>

  <section class="achievements-section">
    <div class="achievements-section__header">
      <h2>History</h2>
      <p class="achievements-section__meta"><%= pluralize(@history.size, "event") %></p>
    </div>

    <% if @history.any? %>
      <ul class="xp-feed">
        <% @history.each do |event| %>
          <li class="xp-feed__row">
            <%= link_to user_path(event.user), class: "leaderboard-row__avatar-wrap" do %>
              <% if event.user.avatar_url.present? %>
                <%= image_tag event.user.avatar_url, alt: "", class: "leaderboard-row__avatar" %>
              <% else %>
                <span class="leaderboard-row__avatar leaderboard-row__avatar--placeholder"><%= event.user.display_name&.first&.upcase || "?" %></span>
              <% end %>
            <% end %>
            <span class="xp-feed__description">
              <%= link_to event.user.display_name.presence || "Unknown Player", user_path(event.user), class: "xp-feed__entity-link" %>
              <%= event.reason == "achievement_favorited" ? "favorited this" : "unlocked this" %>
            </span>
            <span class="xp-feed__time"><%= time_ago_in_words(event.created_at) %> ago</span>
          </li>
        <% end %>
      </ul>
    <% else %>
      <div class="achievement-empty-state">
        <h3>No activity yet</h3>
        <p>Once someone unlocks or favorites this, it'll show up here.</p>
      </div>
    <% end %>
  </section>

  <%= render "comments/comments", commentable: @achievement %>
</section>
